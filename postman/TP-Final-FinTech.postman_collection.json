{
	"info": {
		"_postman_id": "d4f1a2b3-c4d5-4e6f-8a9b-tpfinalfintech",
		"name": "TP Final FinTech - customer-service / product-service",
		"description": "Coleccion para probar de punta a punta customer-service (8081) y product-service (8082) con el modelo de 3 entidades (Cuenta/PrestamoPersonal/TarjetaCredito). Correr en orden (de arriba hacia abajo) o con Collection Runner: cada request que crea un recurso guarda su id en variables de entorno para que los siguientes requests lo usen automaticamente.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Infraestructura",
			"item": [
				{
					"name": "Eureka - dashboard responde",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{eureka_url}}", "host": ["{{eureka_url}}"] }
					},
					"response": []
				},
				{
					"name": "Eureka - apps registradas (JSON)",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": { "raw": "{{eureka_url}}/eureka/apps", "host": ["{{eureka_url}}"], "path": ["eureka", "apps"] }
					},
					"response": []
				}
			]
		},
		{
			"name": "1. Customer Service",
			"item": [
				{
					"name": "Crear cliente",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 o 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"customerId\", jsonData.id);",
									"console.log(\"customerId guardado:\", jsonData.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"documento\": \"30111222\",\n  \"direccion\": \"Av. Siempre Viva 742\",\n  \"email\": \"juan.perez@mail.com\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{customer_url}}/customers", "host": ["{{customer_url}}"], "path": ["customers"] }
					},
					"response": []
				},
				{
					"name": "Listar clientes",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{customer_url}}/customers", "host": ["{{customer_url}}"], "path": ["customers"] }
					},
					"response": []
				},
				{
					"name": "Obtener cliente por id",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{customer_url}}/customers/{{customerId}}", "host": ["{{customer_url}}"], "path": ["customers", "{{customerId}}"] }
					},
					"response": []
				},
				{
					"name": "Actualizar cliente",
					"request": {
						"method": "PUT",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"documento\": \"30111222\",\n  \"direccion\": \"Av. Siempre Viva 999\",\n  \"email\": \"juan.perez@mail.com\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{customer_url}}/customers/{{customerId}}", "host": ["{{customer_url}}"], "path": ["customers", "{{customerId}}"] }
