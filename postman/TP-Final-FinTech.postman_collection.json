		{
			"name": "5. Agregador (Feign)",
			"item": [
				{
					"name": "Perfil del cliente (cliente + cuentas + prestamos + tarjetas)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"tiene cliente\", function () { pm.expect(jsonData.cliente).to.not.be.undefined; });",
									"pm.test(\"tiene cuentas\", function () { pm.expect(jsonData.cuentas.length).to.be.above(0); });",
									"pm.test(\"tiene prestamos\", function () { pm.expect(jsonData.prestamos.length).to.be.above(0); });",
									"pm.test(\"tiene tarjetas\", function () { pm.expect(jsonData.tarjetas.length).to.be.above(0); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{customer_url}}/customers/{{customerId}}/products", "host": ["{{customer_url}}"], "path": ["customers", "{{customerId}}", "products"] }
					},
					"response": []
				}
			]
